QMainWindow {
    background-color: #abd7c4;
}

QPushButton {
    background-color: #70de8f;
    color: black;
    font-size: 16px;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 8px;
}

QPushButton:hover {
    background-color: #33d255;
}

QPushButton:pressed {
    background-color: #24d75d;
}

QToolBar {
    background-color: #a6eec4;
    border: none;
}
